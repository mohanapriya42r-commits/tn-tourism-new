# Copy this file to backend/.env and fill in your real values.
# backend/.env is git-ignored and must NEVER be committed.

# MongoDB connection URI (Atlas or local).
# Local fallback used automatically if this is missing: mongodb://127.0.0.1:27017/tn_tourism
MONGODB_URI=

# Port the Express server listens on (defaults to 5000 if unset).
PORT=5000

# Secret used to sign the custom JWT auth tokens.
# If unset, a hardcoded dev secret is used — set this in production!
JWT_SECRET=