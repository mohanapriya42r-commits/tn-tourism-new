# Vite environment variables for the React frontend.
# Copy this file to .env and fill in your values.
# NOTE: VITE_* variables are intentionally public — they are baked into
# the client bundle at build time. Do NOT put secrets here.

# Public URL of the Node.js backend (Express server).
# Local development fallback: http://localhost:5000
# Production (Vercel + Render): set this to your Render web service URL,
# e.g. https://tn-tourism-backend.onrender.com
VITE_API_URL=http://localhost:5000